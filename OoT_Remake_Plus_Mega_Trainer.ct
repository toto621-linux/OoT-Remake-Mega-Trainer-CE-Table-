  [1562]={0xB0A1BF51,0xA63F1E2D,0x4D345BBE,'Item_BombBag_Small'},
  [1563]={0x7B9673F5,0xB669F025,0x1C0B4BEC,'Item_BulletBag_Large'},
  [1564]={0x9A30A9E5,0xE6CD55D2,0x78681CDD,'Item_BulletBag_Medium'},
  [1565]={0xDC52ACAF,0x488CA1BE,0xB66EC399,'Item_BulletBag_Small'},
  [1566]={0x9A826FAB,0x944B78BE,0xC1B79C02,'Item_FairyBless_DefenseDouble'},
  [1567]={0xD60E4B23,0x9A5DB0B6,0x195DE3FF,'Item_NutBag_Large'},
  [1568]={0xEAA1785E,0x960820DB,0x315DA972,'Item_NutBag_Medium'},
  [1569]={0x19B80DBC,0x2BEDD82E,0xFBFDA62B,'Item_NutBag_Small'},
  [1570]={0xD331C7DA,0x21985B09,0x7E6DF1D,'Item_Quiver_Large'},
  [1571]={0x3BB370E1,0x9D872202,0xD70016F1,'Item_Quiver_Medium'},
  [1572]={0xA8C3E1FB,0xA550531,0xCE1AA33D,'Item_Quiver_Small'},
  [1573]={0x48E53698,0xA10F2DCF,0x42F9F847,'Item_StickBag_Large'},
  [1574]={0x41DB7AB5,0xCBF00480,0x435380E7,'Item_StickBag_Medium'},
  [1575]={0x2FE6AB1A,0xDE2389D4,0x269A4B46,'Item_StickBag_Small'},
  [1576]={0xAFA4BB52,0xB5031190,0x65796826,'Item_Wallet_Large'},
  [1577]={0x2D2C874B,0xD1360DE8,0x6093656F,'Item_Wallet_Medium'},
  [1578]={0x1D74617E,0xB6E5A3A5,0x4F4EB2F1,'Item_Wallet_Small'},
  [1579]={0x20820479,0x3506A557,0x51496D45,'Pouch_Amiibo'},
  [1580]={0xE32AD20F,0xF9FE4FFC,0x48A03E62,'Pouch_Range_BowAndArrow_Fire'},
  [1581]={0x667C7BA3,0x989E62D,0x6A86B26E,'Pouch_Range_BowAndArrow_Ice'},
  [1582]={0x28298287,0xB03AE135,0x9B869C05,'Pouch_Range_BowAndArrow_Light'},
}
local BOTTLE_DEFINITIONS={
  [1530]={0xD53CE3A7,0xF39CE410,0x7D48DF76},
  [1531]={0xFCA29A04,0xFF6EA,0x1EDD164A},
  [1532]={0x893216A1,0xF63B1194,0xB80C70A8},
  [1533]={0x5324F9D3,0xB7F052CE,0xE4C1B1FC},
  [1534]={0xC92B16BE,0xE27B136D,0x365E1953},
}
local MAGIC_BLESSINGS={
  {0x5E671D92,0xB1309073,0x958C80F},
  {0x5F043856,0x87CA4826,0x9393E906},
}

local function bytesAt(address,size)
  local ok,bytes=pcall(readBytes,address,size,true)
  if ok and type(bytes)=='table' and #bytes==size then return bytes end
end
local function littleU32(bytes,i)
  return bytes[i] | bytes[i+1]&lt;&lt;8 | bytes[i+2]&lt;&lt;16 | bytes[i+3]&lt;&lt;24
end
local function typedLookup(first,count)
  -- GameData keeps two hash/index buckets per record directly before the array.
  local bytes=bytesAt(first-count*16,count*16)
  if not bytes then return nil end
  local indices,seen={},{}
  local used=0
  for i=1,#bytes,8 do
    local hash,index=littleU32(bytes,i),littleU32(bytes,i+4)
    if hash~=0 then
      if index&gt;=count or indices[hash] or seen[index] then return nil end
      indices[hash]=index
      seen[index]=true
      used=used+1
    end
  end
  if used==count then return indices end
end
local function findRecords(root,tag,fromOffset,toOffset,stride,valueOffset,count,anchorHash,anchorIndex)
  local start=root+fromOffset
  start=start-start%8
  local bytes=bytesAt(start,toOffset-fromOffset)
  if not bytes then return nil end
  for i=1,#bytes-stride*2-3,8 do
    if littleU32(bytes,i)==tag and littleU32(bytes,i+stride)==tag and littleU32(bytes,i+2*stride)==tag and
       (i&lt;=stride or littleU32(bytes,i-stride)~=tag) then
      local first=start+i-1
      local indices=typedLookup(first,count)
      if indices and indices[anchorHash]==anchorIndex then
        return {first=first,tag=tag,stride=stride,valueOffset=valueOffset,indices=indices}
      end
    end
  end
end
local function field(records,hash)
  local index=records and records.indices[hash]
  if not index then return nil end
  local entry=records.first+index*records.stride
  if u32(entry)==records.tag then return entry+records.valueOffset end
end
local function readInventory(root)
  local first=root-962*0x28-0x1C
  local tag=u32(first)
  if not tag or tag==0 then return nil end
  local indices=typedLookup(first,1260) or typedLookup(first,1259)
  if not indices or indices[0xA77921D7]~=962 or indices[0xE0010A50]~=976 then return nil end
  for hash,index in pairs(INVENTORY_INT_INDEX) do
    if indices[hash]~=index or u32(first+index*0x28)~=tag then return nil end
  end
  local hasMajora=indices[0x2B043D6D]==1259
  local inventory={root=root,int={first=first,tag=tag,stride=0x28,valueOffset=0x1C,indices=indices}}
  inventory.bool=findRecords(root,tag-0xC0,-0x68000,-0x56000,0x18,0x16,
    hasMajora and 11305 or 11292,0x7AE38E5B,0x2337)
  inventory.enum=findRecords(root,tag+0x180,0x15000,0x20000,0x38,0x1C,130,0x7D48DF76,60)
  inventory.string=findRecords(root,tag+0x540,0x22000,0x30000,0x108,0x74,54,0xA95A3521,23)
  return inventory
end
local function readField(address,size)
  if size==1 then return rb(address) end
  if size==64 then return readString(address,64) end
  return u32(address)
end
local function planWrite(changes,address,size,value)
  if not address then error('The required GameData field was not verified.') end
  local before=readField(address,size)
  if before==nil then error('The GameData field is no longer readable.') end
  if size==1 and before&gt;1 then error('The acquisition flag has an unexpected value.') end
  if before~=value then changes[#changes+1]={address=address,size=size,before=before,value=value} end
end
local function readChange(change)
  return readField(change.address,change.size)
end
local function writeChange(change,value)
  if change.size==1 then writeBytes(change.address,value)
  elseif change.size==64 then
    local bytes={}
    for i=1,64 do bytes[i]=value:byte(i) or 0 end
    writeBytes(change.address,bytes)
  else writeInteger(change.address,value) end
end
local function commitChanges(changes)
  local applied=0
  local ok,err=pcall(function()
    for i,change in ipairs(changes) do
      if readChange(change)~=change.before then error('The game changed a field while preparing the edit.') end
      applied=i
      writeChange(change,change.value)
      if readChange(change)~=change.value then error('Could not verify a GameData write.') end
    end
  end)
  if ok then return end
  local restored=true
  for i=applied,1,-1 do
    local change=changes[i]
    if readChange(change)==change.value then
      local wrote=pcall(writeChange,change,change.before)
      if not wrote or readChange(change)~=change.before then restored=false end
    elseif readChange(change)~=change.before then restored=false end
  end
  if not restored then error(tostring(err)..' The rollback could not be verified.') end
  error(err)
end
local function planAcquisition(changes,inventory,definition)
  planWrite(changes,field(inventory.bool,definition[2]),1,1)
  planWrite(changes,field(inventory.bool,definition[3]),1,1)
end
local function checkUnequipped(inventory,actor)
  if actor=='Armor_Adult_Normal' or actor=='Obj_Armor_Child_Normal' then
    error('The default tunic cannot be removed.')
  end
  if not actor:match('^Weapon_Sword_') and not actor:match('^Weapon_Shield_') then return end
  for _,hash in ipairs({0xA95A3521,0xEE463235,0xA1F7EE2B,0x2342B619}) do
    local address=field(inventory.string,hash)
    local equipped=address and readString(address,64)
    if equipped==nil then error('The equipment for both eras could not be checked.') end
    if equipped==actor then error('Unequip this item in both eras before removing it.') end
  end
end
local function changeOwnership(inventory,record,definition,bottle)
  local address=field(inventory.int,definition[1])
  local old=address and u32(address)
  if old==nil or (not bottle and old~=0 and old~=1) then error('The item stock could not be verified.') end
  local owned=old&gt;0
  local nextStock=owned and 0 or 1
  local changes={}
  if bottle then
    local valid=field(inventory.bool,definition[2])
    local content=field(inventory.enum,definition[3])
    if not valid or not content or rb(valid)~=(owned and 1 or 0) then error('The bottle ownership fields could not be verified.') end
    planWrite(changes,content,4,0xBE69DE49)
    planWrite(changes,valid,1,nextStock)
  elseif not owned then
    planAcquisition(changes,inventory,definition)
  else
    checkUnequipped(inventory,definition[4])
  end
  planWrite(changes,address,4,nextStock)
  local question=(owned and 'Remove ' or 'Unlock ')..record.Description..'?'
  if bottle and owned then question=question..'\nThis also empties the bottle.' end
  if messageDialog(question,mtConfirmation,mbYes,mbNo)==mrYes and active() then
    commitChanges(changes)
    if bottle and state.bottleContents then state.bottleContents[record.ID]=nil end
    if bottle and state.bottlePending then state.bottlePending[record.ID]=nil end
  end
end
local function changeMagicMeter(inventory)
  local maximum=field(inventory.int,0x12D63A97)
  local before=maximum and u32(maximum)
  if before~=0 and before~=240 and before~=480 then error('The current magic tier could not be verified.') end
  local answer=inputQuery('Magic Meter','Enter 24 or 48 MP',tostring(before/10))
  if not answer or not active() then return end
  local mp=tonumber(answer)
  if (mp~=24 and mp~=48) or mp*10&lt;before then error('Choose the current magic tier or an upgrade.') end
  local changes={}
  planAcquisition(changes,inventory,MAGIC_BLESSINGS[1])
  planWrite(changes,field(inventory.int,MAGIC_BLESSINGS[1][1]),4,1)
  if mp==48 then
    planAcquisition(changes,inventory,MAGIC_BLESSINGS[2])
    planWrite(changes,field(inventory.int,MAGIC_BLESSINGS[2][1]),4,1)
  end
  planWrite(changes,maximum,4,mp*10)
  planWrite(changes,field(inventory.int,0x76B18200),4,mp*10)
  if state.magicAddress and validActiveMagic(state.magicAddress-0x0C) then
    planWrite(changes,state.magicAddress,4,mp*10)
  end
  commitChanges(changes)
end

-- Each stock has a separate IsGet flag. Seeds and arrows also require their launcher.
local CONSUMABLES={
  {stock=0x5FADF7FC, acquired=0x29888E1E, capacity=0xAE8CC742, tool=0x80D34CE9}, -- Deku Seeds
  {stock=0x518EC74B, acquired=0x572701EA, capacity=0x418DB791, tool=0x938D56BF}, -- Arrows
  {stock=0xDB1BCD4F, acquired=0x2BB00768, capacity=0xE753508B}, -- Bombs
  {stock=0xDF7C517A, acquired=0x5AB49C8E, capacity=0xE753508B}, -- Bombchus
  {stock=0xF30D9F54, acquired=0x00C2EE37, capacity=0x735B00F7}, -- Deku Nuts
  {stock=0x600E29EB, acquired=0xCFBB16F6, limit=30}, -- Business Scrub Seeds
  {stock=0xB003124D, acquired=0x6D39C600, limit=10}, -- Magic Beans
  {stock=0xB9494411, acquired=0xC4E21AC2, capacity=0x457616B0}, -- Deku Sticks
}
local function refillConsumables()
  local inventory=state.inventory
  if not inventory then return end
  for _,item in ipairs(CONSUMABLES) do
    local stock=field(inventory.int,item.stock)
    local value=stock and ri(stock)
    local flag=field(inventory.bool,item.acquired)
    if value and value&gt;0 and flag and rb(flag)==1 then
      local capacity=field(inventory.int,item.capacity)
      local ceiling=item.limit or (capacity and ri(capacity))
      local tool=item.tool and field(inventory.int,item.tool)
      if ceiling and value&lt;ceiling and (not item.tool or (tool and ri(tool)==1)) and ri(stock)==value then
        writeInteger(stock,ceiling)
      end
    end
  end
end

local EMPTY_BOTTLE, FULL_MILK, HALF_MILK=0xBE69DE49,0x73356827,0xEEF6E4B0
local BOTTLE_CONTENTS={
  [0xEABA6067]=true, [0x049D37C1]=true, [0xF383D6E5]=true, -- Potions
  [0x1C293517]=true, [0x1E834EF8]=true, [0x0F24E808]=true, -- Blue Fire, Fish, Letter
  [0xCDC21471]=true, [0x02084F9E]=true, [0x74D62ECB]=true, -- Big Poe, Poe, Bug
  [0x6F49E357]=true, [FULL_MILK]=true, [HALF_MILK]=true, -- Fairy and Milk
}
local function bottleActionReady(fastmem)
  local owner=activeHeartOwner()
  if not owner then return nil end
  local actor=fastmem+owner
  local primary,secondary=u32(actor+0x4AC),u32(actor+0xC54)
  if not primary or not secondary or (secondary &amp; 0xFFFF0000)~=0x01FF0000 then return nil end
  local ok,attachment=pcall(readQword,actor+0x1990)
  if not ok or attachment==nil then return nil end
  -- These action flags remain set after the bottle becomes empty. The
  -- actor's attachment returns only once the native action has finished.
  return (primary &amp; 0x80)==0 and (secondary &amp; 0x40)==0 and attachment~=0
end
local function bottleFastmemBase(inventory)
  local views=state.rupeeViews
  local head=field(inventory.string,0x59D9C7B3)
  local weapon=field(inventory.string,0xA95A3521)
  if not views or not head or not weapon then return nil end
  for allocation,delta in pairs(views.offsets) do
    local aliasHead,aliasWeapon=head+delta,weapon+delta
    if mappedAllocation(aliasHead)==allocation and mappedAllocation(aliasWeapon)==allocation then
      -- Both String64 buffers carry their own guest address at value - 0x0C.
      local h,w=readQword(aliasHead-0x0C),readQword(aliasWeapon-0x0C)
      if h and w and h&gt;0 and w&gt;0 then
        local base=aliasHead-h
        if base&gt;0 and base%0x10000==0 and base==aliasWeapon-w and bottleActionReady(base)~=nil then
          return base
        end
      end
    end
  end
end
local function refillBottles()
  local inventory=state.inventory
  local remembered=state.bottleContents
  local pending=state.bottlePending
  if not inventory or not remembered or not pending then return end
  local ready=bottleActionReady(state.bottleFastmem)
  local now=getTickCount()
  if ready==nil and not activeHeartOwner() and state.refreshVital then state.refreshVital('hearts') end
  for id,definition in pairs(BOTTLE_DEFINITIONS) do
    local stock=field(inventory.int,definition[1])
    local valid=field(inventory.bool,definition[2])
    local content=field(inventory.enum,definition[3])
    if stock and (ri(stock) or 0)&gt;0 and valid and rb(valid)==1 and content then
      local value=u32(content)
      local previous=remembered[id]
      if previous and (value==EMPTY_BOTTLE or (previous==FULL_MILK and value==HALF_MILK)) then
        local refill=pending[id]
        if not refill or refill.after~=value then
          refill={after=value,since=now}
          pending[id]=refill
        end
        if ready then
          refill.readySince=refill.readySince or now
          if now-refill.since&gt;=2500 and now-refill.readySince&gt;=120 and
             u32(content)==value and rb(valid)==1 and (ri(stock) or 0)&gt;0 and bottleActionReady(state.bottleFastmem) then
            writeInteger(content,previous)
          end
        else
          refill.readySince=nil
        end
      elseif BOTTLE_CONTENTS[value] then
        remembered[id]=value
        pending[id]=nil
      elseif value~=EMPTY_BOTTLE then
        remembered[id]=nil
        pending[id]=nil
      end
    else
      remembered[id]=nil
      pending[id]=nil
    end
  end
end

local function refillTarget(kind)
  if kind=='magic' then
    local address=state.magicAddress
    local live=address and validActiveMagic(address-0x0C)
    if not live then return nil end
    local maximum=field(state.inventory and state.inventory.int,0x12D63A97)
    local cap=maximum and u32(maximum)
    if cap~=240 and cap~=480 then return address end
    return address,live.value,cap
  end
  if kind=='hearts' then
    local address=state.heartAddress
    if not address then return nil end
    local live=state.legacyHearts and validLegacyHearts(address+0xE0) or validHeartRecord(address+4)
    if live then return address,live.a,live.b end
    return nil
  end
  local address=state.rupeeAddress
  local live=address and readRupeeCandidates(address)
  if live then return address,live.x,live.c end
end
local function setRefill(kind,enabled)
  if not state.refills then state.refills={} end
  local usesInventory=kind=='consumables' or kind=='bottles'
  if enabled then
    if not active() or state.scanning then error('Enable the trainer and wait for detection.') end
    if usesInventory then
      local inventory=state.inventory
      if not inventory or not inventory.bool or (kind=='bottles' and not inventory.enum) then
        error('The required inventory fields were not verified.')
      end
    elseif not refillTarget(kind) then error('This value could not be detected.') end
    if state.refills[kind] then return end
    if kind=='bottles' then
      state.bottleFastmem=bottleFastmemBase(state.inventory)
      if not state.bottleFastmem then error('The player bottle action state could not be verified.') end
    end
  end
  state.refills[kind]=enabled or nil
  if kind=='bottles' then
    state.bottleContents=enabled and {} or nil
    state.bottlePending=enabled and {} or nil
    if enabled then refillBottles() end
    if not enabled then state.bottleFastmem=nil end
  elseif kind=='consumables' and enabled then refillConsumables() end
  if not next(state.refills) then
    if state.timer then state.timer.destroy(); state.timer=nil end
    return
  end
  local interval=state.refills.bottles and 40 or 120
  if state.timer then state.timer.Interval=interval; return end
  state.timer=createTimer(nil)
  state.timer.Interval=interval
  state.timer.OnTimer=function()
    if not active() then state.timer.destroy(); state.timer=nil; return end
    for vital in pairs(state.refills) do
      if vital=='consumables' then refillConsumables()
      elseif vital=='bottles' then refillBottles()
      else
        local address,value,ceiling=refillTarget(vital)
        if not address then
          if state.refreshVital then state.refreshVital(vital) end
        elseif value and ceiling and value&lt;ceiling and (vital~='hearts' or value&gt;0) then
          writeInteger(address,ceiling)
        end
      end
    end
  end
end
state.setRefill=setRefill

-- PouchTable lists these masks in the display order of its two equipment tiles.
local MASK_SLOTS={
  [1621]={title='Normal Mask Slot',ids={1116,1112,1117,1111,1110,1115,1114,1113}},
  [1622]={title='Amiibo Mask Slot',ids={1108,1109,1169}},
}
local function maskInSlot(inventory,slot)
  for _,id in ipairs(slot.ids) do
    local stock=field(inventory.int,ITEM_DEFINITIONS[id][1])
    if stock and u32(stock)==1 then return id end
  end
  return 0
end
local function chooseSlotMask(inventory,slot,list)
  local owned=maskInSlot(inventory,slot)
  local ids={0}
  local form=createForm(false)
  local ok,id=pcall(function()
    form.Caption=slot.title
    form.Position='poScreenCenter'
    form.BorderStyle='bsDialog'
    form.ClientWidth=330
    form.ClientHeight=140
    local label=createLabel(form)
    label.Left=16; label.Top=14
    label.Caption='Choose which mask appears in this inventory slot.'
    local combo=createComboBox(form)
    combo.Left=16; combo.Top=40; combo.Width=298
    combo.Style='csDropDownList'
    combo.Items.add('Empty')
    local selected=0
    for _,id in ipairs(slot.ids) do
      if field(inventory.int,ITEM_DEFINITIONS[id][1]) then
        combo.Items.add(list.getMemoryRecordByID(id).Description)
        ids[#ids+1]=id
        if id==owned then selected=#ids-1 end
      end
    end
    combo.ItemIndex=selected
    local apply=createButton(form)
    apply.Caption='Apply'; apply.Left=145; apply.Top=86; apply.Default=true; apply.ModalResult=mrOK
    local cancel=createButton(form)
    cancel.Caption='Cancel'; cancel.Left=231; cancel.Top=86; cancel.Cancel=true; cancel.ModalResult=mrCancel
    if form.showModal()==mrOK then return ids[combo.ItemIndex+1] end
  end)
  form.destroy()
  if not ok then error(id) end
  return id
end
local function replaceMaskSlot(inventory,slot,list)
  local selected=chooseSlotMask(inventory,slot,list)
  if selected==nil or not active() then return end
  local equipped=field(inventory.string,0x59D9C7B3)
  local wearing=field(inventory.bool,0xC27C80FB)
  local oldActor=equipped and readString(equipped,64)
  if not oldActor or not wearing then error('The worn mask fields could not be verified.') end
  local changes={}
  local selectedItem=ITEM_DEFINITIONS[selected]
  if selectedItem then planAcquisition(changes,inventory,selectedItem) end
  local replacesWornMask=false
  for _,id in ipairs(slot.ids) do
    local item=ITEM_DEFINITIONS[id]
    local stock=field(inventory.int,item[1])
    if stock then
      local current=u32(stock)
      if current~=0 and current~=1 then error('The mask stock could not be verified.') end
      planWrite(changes,stock,4,id==selected and 1 or 0)
    elseif id==selected or id~=1169 then
      error('A mask required by this slot could not be verified.')
    end
    if item[4]==oldActor then replacesWornMask=true end
  end
  if replacesWornMask then
    planWrite(changes,equipped,64,selectedItem and selectedItem[4] or '')
    if not selectedItem then planWrite(changes,wearing,1,0) end
  end
  commitChanges(changes)
end
-- IsGet.Item_Melody flags, in the order shown in the song group.
local SONG_FLAGS={
  0x01C20002, 0xB492AC33, 0xD3F8BFCC, 0x165DD1AD,
  0x03B3450E, 0x2B39DD4F, 0xDC0A0B54, 0x49041AB9,
  0x3FA63986, 0xC2FB95F4, 0x802A36A8, 0xD6320BA4,
}
local function openInventory(root)
  local inventory=readInventory(root)
  if not inventory then log('INVENTORY: GameData integer layout not recognized.'); return end
  state.inventory=inventory
  registerSymbol('OoT_Inventory_A',root,true)
  local majora=field(inventory.int,ITEM_DEFINITIONS[1169][1])
  if majora and field(inventory.bool,ITEM_DEFINITIONS[1169][2]) and field(inventory.bool,ITEM_DEFINITIONS[1169][3]) then
    registerSymbol('OoT_MajoraStock_A',majora,true)
  end
  for id,definition in pairs(BOTTLE_DEFINITIONS) do
    local content=field(inventory.enum,definition[3])
    if content then registerSymbol('OoT_BottleContent_'..id,content,true) end
  end
  local list=getAddressList()
  local previous=list.OnValueChange
  local bottleA=list.getMemoryRecordByID(1530)
  local previousBottleDisplay=bottleA and bottleA.OnGetDisplayValue
  if bottleA then
    local definition=BOTTLE_DEFINITIONS[1530]
    bottleA.OnGetDisplayValue=function(record,value)
      if active() then
        local stock=field(inventory.int,definition[1])
        local validity=field(inventory.bool,definition[2])
        local count=stock and ri(stock)
        local valid=validity and rb(validity)
        if count and count&gt;0 and valid==1 then return true,'Owned' end
        if count==0 and valid==0 then return true,'Absent' end
      end
      if previousBottleDisplay then return previousBottleDisplay(record,value) end
      return false
    end
  end
  local songSymbols={}
  for index,hash in ipairs(SONG_FLAGS) do
    local address=field(inventory.bool,hash)
    local value=address and rb(address)
    if value==0 or value==1 then
      local symbol='OoT_OcarinaSong_'..index
      registerSymbol(symbol,address,true)
      songSymbols[#songSymbols+1]=symbol
    end
  end
  local slotRecords={}
  for id,slot in pairs(MASK_SLOTS) do
    local record=list.getMemoryRecordByID(id)
    if record then
      slotRecords[#slotRecords+1]=record
      record.OnActivate=function(_,before) return not before end
      record.OnGetDisplayValue=function()
        if not active() then return false end
        local id=maskInSlot(inventory,slot)
        local item=id~=0 and list.getMemoryRecordByID(id)
        return true,item and item.Description or 'Empty'
      end
    end
  end
  local function onValueChange(sender,record)
    local item=ITEM_DEFINITIONS[record.ID]
    local bottle=BOTTLE_DEFINITIONS[record.ID]
    local maskSlot=MASK_SLOTS[record.ID]
    if item or bottle or record.ID==1521 or maskSlot then
      if not active() then return true end
      local ok,err=pcall(function()
        if record.ID==1521 then changeMagicMeter(inventory)
        elseif maskSlot then replaceMaskSlot(inventory,maskSlot,list)
        else changeOwnership(inventory,record,item or bottle,bottle~=nil) end
      end)
      if not ok then showMessage(tostring(err)) end
      return true
    end
    local contentBottle=BOTTLE_DEFINITIONS[record.ID-10]
    if contentBottle and record.ID&gt;=1540 and record.ID&lt;=1544 then
      local stock=field(inventory.int,contentBottle[1])
      local valid=field(inventory.bool,contentBottle[2])
      if not active() or not stock or not valid or (u32(stock) or 0)==0 or rb(valid)~=1 then
        showMessage('Unlock this bottle before editing its contents.')
        return true
      end
    end
    if previous then return previous(sender,record) end
    return false
  end
  list.OnValueChange=onValueChange
  state.closeInventory=function()
    list.OnValueChange=previous
    if bottleA then bottleA.OnGetDisplayValue=previousBottleDisplay end
    for _,symbol in ipairs(songSymbols) do pcall(unregisterSymbol,symbol) end
    for _,record in ipairs(slotRecords) do
      record.OnActivate=nil
      record.OnGetDisplayValue=nil
    end
  end
  log(string.format('INVENTORY READY: integer fields found, acquisitions=%s bottles=%s equipped items=%s Majora=%s',
    tostring(inventory.bool~=nil),tostring(inventory.enum~=nil),tostring(inventory.string~=nil),tostring(majora~=nil)))
end

local function registerSet(symbols,addresses)
  for i,s in ipairs(symbols) do registerSymbol(s,addresses[i],true) end
end
local function setLuaWindowVisible(visible)
  local ok,err=pcall(function()
    local engine=getLuaEngine()
    if engine then
      if visible then engine.show() else engine.hide() end
    end
  end)
  if not ok then log('Lua window visibility ERROR: '..tostring(err)) end
end
-- Run exactly one full-process AOB scan at a time, in a worker thread.
-- Do not run the second scan until the first scan has finished and its results
-- have been validated. This reduces simultaneous load on Lichii.
local function runScan(kind,pattern,flags,limit,validator,symbols,addresses,onComplete,alignment)
  local isHearts=symbols==HS
  local isMagic=symbols==MS
  local legacyHearts=validator==validLegacyHearts
  local includeMapped=type(setSpecialScanOptionsOverride)=='function'
  createThread(function(th)
    local ok,res=pcall(function()
      -- Fritchii exposes these GameData records in MEM_MAPPED regions. +W only
      -- selects page protection and does not include those regions by itself.
      if includeMapped then setSpecialScanOptionsOverride({MEM_MAPPED=true}) end
      if alignment then return AOBScan(pattern,flags,1,alignment) end
      return AOBScan(pattern,flags)
    end)
    if includeMapped then setSpecialScanOptionsOverride({}) end
    local hits={}; local total=0; local parseErrors=0
    if ok and res then
      total=res.Count
      if total&lt;=limit then
        for i=0,total-1 do
          local a=tonumber(res[i],16)
          if a then hits[#hits+1]=a else parseErrors=parseErrors+1 end
        end
      end
      res.destroy()
    end
    th.synchronize(function()
      if not active() then return end
      if not ok then
        log(kind..' scan ERROR: '..tostring(res))
        -- Final UI decision is made after both sequential scans.
        if onComplete then onComplete('error') end
        return
      end
      log(kind..' AOB hits='..total..' flags='..flags..(includeMapped and ' MEM_MAPPED included' or ''))
      if isHearts then
        local ref=_G.OoT_HeartReferenceAddress
        if type(ref)=='string' then ref=tonumber(ref:gsub('^0[xX]',''),16) end
        if type(ref)=='number' and ref&gt;0 then
          local anchor=ref+(legacyHearts and 0xE0 or 4)
          local present=false
          for _,a in ipairs(hits) do if a==anchor then present=true; break end end
          log(string.format('%s includes_reference_anchor=%s anchor=%X',kind,tostring(present),anchor))
        end
      end
      if total&gt;limit or parseErrors&gt;0 then
        log(kind..' result limit/parse failure; no addresses registered.')
        -- Final UI decision is made after both sequential scans.
        if onComplete then onComplete('error') end
        return
      end
      local good={}
      local rejects={ids=0,health=0,a0=0,c0=0,other=0}
      for _,a in ipairs(hits) do
        local c,reason=validator(a)
        if c then good[#good+1]=c
        else rejects[reason or 'other']=(rejects[reason or 'other'] or 0)+1 end
      end
      if legacyHearts then
        log(string.format('HEARTS rejects ids=%d health=%d A0=%d C0=%d other=%d',rejects.ids,rejects.health,rejects.a0,rejects.c0,rejects.other))
        local strict={}
        for _,c in ipairs(good) do if c.strict then strict[#strict+1]=c end end
        log('HEARTS strict='..#strict..' relaxed='..#good)
        if #strict&gt;0 then good=strict end
      end
      log(kind..' structurally valid='..#good)
      if #good==0 then
        for reason,count in pairs(rejects) do
          if count&gt;0 then log(string.format('%s rejected %d: %s',kind,count,reason)) end
        end
      end
      local rupeeViews
      if #good&gt;1 then
        for i,c in ipairs(good) do
          if isHearts then
            log(string.format('%s candidate #%d hearts=%X values=%d/%d',kind,i,c.h,c.a,c.b))
          elseif isMagic then
            log(string.format('%s candidate #%d magic=%X value=%d',kind,i,c.m,c.value))
          else
            log(string.format('%s candidate #%d rupees=%X values=%d/%d wallet=%X capacities=%d/%d',kind,i,c.r,c.x,c.y,c.w,c.c,c.d))
          end
        end
        local matchedRupees,backing
        local addressKey=isHearts and 'h' or (isMagic and 'm' or 'r')
        if (isHearts or isMagic) and state.rupeeViews then
          local ok,candidate=pcall(vitalCandidateFromRupees,good,addressKey)
          if ok and candidate then backing,matchedRupees=candidate,true end
        end
        if not backing then
          local ok,candidate,views=pcall(physicalCandidate,good,addressKey)
          if ok then backing,rupeeViews=candidate,views end
        end
        if backing then
          local basis=matchedRupees and 'using the verified rupee allocations and offsets' or 'using mapped-page comparison'
          log(string.format('%s: %d mapped views match the RAM backing at %X %s.',kind,#good,backing[addressKey],basis))
          good={backing}
        else
          log(kind..': could not confirm that the candidates are mapped views of the same RAM.')
        end
      end
      local status=#good==0 and 'absent' or 'ambiguous'
      if #good==1 then
        local c=good[1]
        local okreg,err=pcall(registerSet,symbols,addresses(c))
        if okreg then
          status='ready'
          if isMagic then
            state.magicAddress=c.m
            log(string.format('READY active magic=%X (%d)',c.m,c.value))
          elseif not isHearts then
            state.rupees=true
            state.rupeeAddress=c.r
            state.rupeeViews=rupeeViews
            local inventoryOk,inventoryError=pcall(openInventory,c.r)
            if not inventoryOk then log('INVENTORY ERROR: '..tostring(inventoryError)) end
            log(string.format('READY rupees A=%X (%d) wallet A=%X (%d) scan=%s',c.r,c.x,c.w,c.c,kind))
          else
            state.hearts=true
            state.heartAddress=c.h
            state.legacyHearts=legacyHearts
            local validation=legacyHearts and (c.strict and 'STRICT' or 'RELAXED') or 'HASHES'
            log(string.format('READY current hearts=%X (%d) max hearts=%X (%d) validation=%s',c.h,c.a,c.h+0x10,c.b,validation))
          end
        else
          status='error'
          for _,sym in ipairs(symbols) do pcall(unregisterSymbol,sym) end
          log(kind..' symbol registration ERROR: '..tostring(err))
        end
      else
        log(kind..' '..status..': no addresses registered.')
      end
      -- Final UI decision is made after both sequential scans.
      if onComplete then onComplete(status) end
    end)
  end)
end
local function finishAll()
  if not active() then return end
  state.scanning=false
  log('COMPLETE rupees/wallet='..(state.rupees and 'READY' or 'UNAVAILABLE')..' hearts='..(state.hearts and 'READY' or 'UNAVAILABLE')..' magic='..(state.magicAddress and 'READY' or 'UNAVAILABLE'))
  if state.rupees and state.hearts and state.magicAddress then setLuaWindowVisible(false)
  else
    if not state.hearts then
      log('Load a playable save, then use Hearts Re-Detect to retry the read-only scan.')
    end
    log('Detection incomplete; Lua window shown for diagnostics.')
    setLuaWindowVisible(true)
  end
end
local function scanHearts(onComplete)
  local function addresses(candidate) return {candidate.h,candidate.h+0x10} end
  runScan('HEARTS RECORDS',HEART_RECORD_PATTERN,'+W',10000,validHeartRecord,HS,addresses,function(status)
    if status=='absent' then
      runScan('HEARTS LEGACY',HEART_LEGACY_PATTERN,'+W',10000,validLegacyHearts,HS,addresses,onComplete)
    else
      onComplete(status)
    end
  end,'4')
end
local function scanRupees(onComplete)
  local function addresses(candidate) return {candidate.r,candidate.w} end
  runScan('RUPEES RECORDS',RUPEE_RECORD_PATTERN,'+W',10000,validRupeeRecord,RS,addresses,function(status)
    if status=='absent' then
      runScan('RUPEES LEGACY',RUPEE_LEGACY_PATTERN,'+W-C',10000,validLegacyRupees,RS,addresses,onComplete,'4')
    else
      onComplete(status)
    end
  end,'4')
end
local function scanMagic(onComplete)
  runScan('ACTIVE MAGIC',MAGIC_RECORD_PATTERN,'+W',10000,validActiveMagic,MS,function(c) return {c.m} end,onComplete,'4')
end
state.refreshVital=function(kind)
  if state.scanning or kind=='rupees' then return end
  local now=getTickCount()
  if state.nextRefresh and now&lt;state.nextRefresh then return end
  state.nextRefresh=now+10000
  state.scanning=true
  if kind=='magic' then
    state.magicAddress=nil
    pcall(unregisterSymbol,MS[1])
    if activeHeartOwner() then scanMagic(finishAll); return end
  end
  state.hearts=false
  state.heartAddress=nil
  for _,symbol in ipairs(HS) do pcall(unregisterSymbol,symbol) end
  scanHearts(function()
    if not active() then return end
    if kind=='magic' then scanMagic(finishAll) else finishAll() end
  end)
end
local function retryHearts()
  if not active() then log('RETRY refused: trainer inactive or process changed.'); return false end
  if state.scanning then log('RETRY refused: scan already running.'); return false end
  if state.hearts then log('RETRY skipped: hearts already detected.'); return true end
  state.scanning=true
  log('RETRY HEARTS: scanning loaded health records.')
  scanHearts(finishAll)
  return true
end
state.retryHearts=retryHearts
_G.OoT_RetryHearts=function()
  if _G.OoT_AOB_State~=state then return false end
  return retryHearts()
end
log('ENABLE: scanning rupees, hearts and active magic; read-only.')
state.scanning=true
scanRupees(function()
  if not active() then return end
  scanHearts(function()
    if active() then scanMagic(finishAll) end
  end)
end)
return ''
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return '' end
if _G.OoT_AOB_State then
  _G.OoT_AOB_State.cancelled=true
  if _G.OoT_AOB_State.closeInventory then pcall(_G.OoT_AOB_State.closeInventory) end
  if _G.OoT_AOB_State.timer then pcall(function() _G.OoT_AOB_State.timer.destroy() end) end
end
for _,s in ipairs({'OoT_Rupees_A','OoT_Wallet_A','OoT_Hearts_A','OoT_MaxHearts_A','OoT_ActiveMagic_A','OoT_Inventory_A','OoT_MajoraStock_A','OoT_BottleContent_1530','OoT_BottleContent_1531','OoT_BottleContent_1532','OoT_BottleContent_1533','OoT_BottleContent_1534'}) do pcall(unregisterSymbol,s) end
_G.OoT_AOB_State=nil
_G.OoT_RetryHearts=nil
print('Disabled; all symbols unregistered. Game memory unchanged.')
